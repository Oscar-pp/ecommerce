<main class="checkout-container">
  <h1>Finalizar compra</h1>

  <form id="payCart" class="checkout-form">
    <!-- 🧍 Datos personales -->
    <fieldset class="form-group">
      <legend>Datos personales</legend>

      <label for="nombre">Nombre</label>
      <input
        type="text"
        id="nombre"
        data-field="nombre"
        data-type="string"
        placeholder="Juan"
        required
      />

      <label for="apellidos">Apellidos</label>
      <input
        type="text"
        id="apellidos"
        data-field="apellidos"
        data-type="string"
        placeholder="Pérez Fernández"
        required
      />

      <label for="telefono">Teléfono</label>
      <input
        type="tel"
        id="telefono"
        data-field="telefono"
        data-type="telefono"
        placeholder="666111333"
      />
    </fieldset>

    <!-- 🏠 Dirección -->
    <fieldset class="form-group">
      <legend>Dirección de envío</legend>

      <label for="direccion">Dirección</label>
      <input
        type="text"
        id="direccion"
        data-field="direccion"
        data-type="string"
        placeholder="Calle Ejemplo 123"
        required
      />

      <label for="ciudad">Ciudad</label>
      <input
        type="text"
        id="ciudad"
        data-field="ciudad"
        data-type="string"
        placeholder="Madrid"
        required
      />

      <label for="cp">Código Postal</label>
      <input
        type="text"
        id="cp"
        data-field="cp"
        data-type="cp"
        placeholder="28001"
        required
        pattern="\d{5}"
      />
    </fieldset>

    <!-- 📧 Acceso -->
    <fieldset class="form-group">
      <legend>Acceso</legend>

      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        data-field="email"
        data-type="email"
        placeholder="ejemplo@email.com"
        required
      />

      <label for="contrasenya">Contraseña</label>
      <input
        type="password"
        id="contrasenya"
        data-field="contrasenya"
        data-type="password"
        placeholder="Contraseña"
        required
      />
    </fieldset>

    <!-- 💳 Pago -->
    <fieldset class="form-group">
      <legend>Método de pago</legend>

      <div class="metodos-pago">
        <label>
          <input type="radio" name="pago" value="tarjeta-info" checked />
          Tarjeta de crédito
        </label>
        <label>
          <input type="radio" name="pago" value="paypal" />
          PayPal
        </label>
        <label>
          <input type="radio" name="pago" value="efectivo-info" />
          Efectivo en tienda
        </label>
      </div>

      <div class="tarjeta-info">
        <label for="tarjeta-numero">Número de tarjeta</label>
        <input
          type="text"
          id="tarjeta-numero"
          data-field="tarjeta_numero"
          data-type="numero"
          placeholder="1234 5678 9012 3456"
        />

        <label for="tarjeta-fecha">Fecha de expiración</label>
        <input
          type="text"
          id="tarjeta-fecha"
          data-field="tarjeta_fecha"
          data-type="fecha"
          placeholder="MM/AA"
        />

        <label for="tarjeta-cvv">CVV</label>
        <input
          type="text"
          id="tarjeta-cvv"
          data-field="tarjeta_cvv"
          data-type="numero"
          placeholder="123"
        />
      </div>

      <div class="paypal">
        <label for="paypal-email">Email de PayPal</label>
        <input
          type="text"
          id="paypal-email"
          data-field="paypal_email"
          data-type="email"
        />
      </div>

      <div class="efectivo-info">
        <p>Paga en tienda al recoger tu pedido.</p>
      </div>
    </fieldset>

    <div class="total-pagar">
      Total a pagar: <span id="totalPriceCheckout">0.00 €</span>
    </div>

    <button type="button" class="btn-pagar">💳 Realizar pago</button>
  </form>

  <!-- Mensaje de confirmación -->
  <div id="mensaje-confirmacion" class="confirmacion-oculta">
    <div class="confirmacion-content">
      <h3>✅ Operación realizada correctamente</h3>
      <p>Gracias por tu compra.</p>
      <p>Recibirás un correo con los detalles de tu pedido.</p>
      <a href="/" class="btn-volver">Volver al catálogo</a>
    </div>
  </div>

  <!-- Mensaje de error -->
  <div class="error-message" hidden>
    <span id="error-message-text"></span>
    <button id="close-error" class="close-error-btn">X</button>
  </div>

  <!-- Procesando pago -->
  <div id="loading-overlay" class="loading-hidden">
    <div class="loading-content">
      <img src="/images/spinner_256.gif" alt="Procesando..." class="loading-gif" />
      <p>Procesando tu pago...</p>
    </div>
  </div>
</main>

<script type="module" src="/js/checkout.js" defer></script>
