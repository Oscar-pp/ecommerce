<header class="header">
  <div class="header-logo">
    <a href="/" class="inline-logo" aria-label="Inicio">
      <i class="fa-solid fa-cart-arrow-down logo"></i>
      <h1>MyShop</h1>
    </a>
  </div>

  <div class="container-navbar <%= hideNavbar ? 'hidden' : '' %>">
    <ul class="navbar" role="navigation" aria-label="Menú principal">
      <li><a href="/">Cultura</a></li>
      <li><a href="/">Ropa</a></li>
      <li><a href="/">Hogar</a></li>
      <li><a href="/">Tecnología</a></li>
      <li><a href="/">Deporte</a></li>
      <li><a href="/">Otros</a></li>
    </ul>
  </div>

  <div class="header-actions">
    <div class="cart" id="cart">
      <button id="cartButton" aria-expanded="false" aria-controls="cartDropdown">
        🛒 <span id="cartCount">0</span>
      </button>

      <div class="cart-dropdown" id="cartDropdown" role="menu" aria-label="Contenido del carrito">
        <ul class="cart-items"></ul>
        <div class="cart-actions">
          <a href="/cart" id="goToCartBtn" class="btn btn-primary">Ver carrito</a>
        </div>
      </div>
    </div>

    <div class="login">
      <button id="loginBtn">Login</button>
    </div>
  </div>
</header>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const loginBtn = document.getElementById("loginBtn");
  if (!loginBtn) return;

  const vendedor = JSON.parse(localStorage.getItem("vendedor"));

  // Si ya está logueado, ocultamos login
  if (vendedor) {
    loginBtn.style.display = "none";
  } else {
    loginBtn.style.display = "inline-block"; // aseguramos que se vea si no hay vendedor
  }

  loginBtn.addEventListener("click", () => {
    window.location.href = "/login";
  });
});

</script>

