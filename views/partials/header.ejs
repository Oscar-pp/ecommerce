<header class="header">
  <div class="header-logo">
    <a href="/" class="inline-logo" aria-label="Inicio">
      <i class="fa-solid fa-cart-arrow-down logo"></i>
    </a>
  </div>

  <div class="container-navbar">
    <ul class="navbar" role="navigation" aria-label="Menú principal">
      <li><a href="/">Cultura</a></li>
      <li><a href="/">Ropa</a></li>
      <li><a href="/">Hogar</a></li>
      <li><a href="/">Tecnología</a></li>
      <li><a href="/">Deporte</a></li>
    </ul>
  </div>

  <div class="header-actions">
    <div class="cart" id="cart">
      <!-- Botón del carrito -->
      <button id="cartButton" aria-expanded="false" aria-controls="cartDropdown">
        🛒 <span id="cartCount">0</span>
      </button>

      <!-- Dropdown del carrito -->
      <div
        class="cart-dropdown"
        id="cartDropdown"
        role="menu"
        aria-label="Contenido del carrito"
      >
        <ul class="cart-items">
          <!-- Tarjetas dinámicamente -->
        </ul>
        <div class="cart-actions">
          <a href="/cart" id="goToCartBtn" class="btn btn-primary">Ver carrito</a>
        </div>
      </div>
    </div>
  </div>
</header>
