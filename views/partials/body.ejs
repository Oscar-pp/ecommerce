<main class="layout">
    <button class="toggle-filtros">🧩 Mostrar filtros</button>

    <aside class="filtros">

        <h3>Filtros</h3>

        <!-- FILTRO NOMBRE -->
        <div class="filtro">
            <label for="nombreProducto">Nombre producto:</label>
            <input 
                id="nombreProducto" 
                name="nombre" 
                list="productos" 
                placeholder="Nombre del producto"
                aria-label="Nombre del producto">
            <datalist id="productos"></datalist>
        </div>

        <!-- FILTRO PRECIO -->
        <div class="filtro">
            <fieldset class="filtro-precio">
                <legend>Rango de precio (€):</legend>
                <div class="precio-inputs">
                    <input 
                        type="number" 
                        id="precio-min" 
                        min="0" max="10000" step="10" value="0" 
                        placeholder="Mín" 
                        aria-label="Precio mínimo en euros">
                    <span>—</span>
                    <input 
                        type="number" 
                        id="precio-max" 
                        min="0" max="10000" step="10" value="10000" 
                        placeholder="Máx" 
                        aria-label="Precio máximo en euros">
                </div>
                <small id="error-precio" class="error-msg" aria-live="polite"></small>
            </fieldset>
        </div>

        <!-- FILTRO RATING -->
        <div class="filtro">
            <fieldset>
                <legend>Valoración mínima:</legend>

                <div class="stars-filter">
                    <input type="radio" name="rating" id="star1" value="1" class="star-input" hidden>
                    <label for="star1" data-value="1" aria-label="una estrella">
                        <svg viewBox="0 0 24 24"><path fill="currentColor"
                        d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    </label>

                    <input type="radio" name="rating" id="star2" value="2" class="star-input" hidden>
                    <label for="star2" data-value="2" aria-label="dos estrellas">
                        <svg viewBox="0 0 24 24"><path fill="currentColor"
                        d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    </label>

                    <input type="radio" name="rating" id="star3" value="3" class="star-input" hidden>
                    <label for="star3" data-value="3" aria-label="tres estrellas">
                        <svg viewBox="0 0 24 24"><path fill="currentColor"
                        d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    </label>

                    <input type="radio" name="rating" id="star4" value="4" class="star-input" hidden>
                    <label for="star4" data-value="4" aria-label="cuatro estrellas">
                        <svg viewBox="0 0 24 24"><path fill="currentColor"
                        d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    </label>

                    <input type="radio" name="rating" id="star5" value="5" class="star-input" hidden>
                    <label for="star5" data-value="5" aria-label="cinco estrellas">
                        <svg viewBox="0 0 24 24"><path fill="currentColor"
                        d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                    </label>
                </div>

                <p id="resultado" aria-live="polite"></p>
            </fieldset>
        </div>

        <!-- FILTRO CATEGORÍA -->
        <div class="filtro">
            <label for="option-category">Categoría:</label>
            <div class="categoria">
                <select name="select-categoria" id="option-category">
                    <option value="" selected>Todos los productos</option>
                    <option value="Ropa">Ropa</option>
                    <option value="Tecnologia">Tecnología</option>
                    <option value="Cultura">Cultura</option>
                    <option value="Hogar">Hogar</option>
                    <option value="Deporte">Deporte</option>
                    <option value="Otros">Otros</option>
                </select>
            </div>
        </div>

        <div class="filtro">
            <button class="btn-filtrar" aria-label="Aplicar filtros de búsqueda">Aplicar filtros</button>
        </div>
    </aside>

    <main class="catalogo" id="catalogo"></main>

</main>

<script type="module" src="../js/gallery.js" defer></script>
