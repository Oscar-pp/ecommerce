<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= titulo %></title>
  <link rel="stylesheet" href="<%= filecss %>">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<body>

  <main class="register-container">

    <form action="/api/register" method="POST" class="register-card" autocomplete="off">

      <h2 class="register-title">Registro de Vendedor</h2>

      <% if (typeof error !== "undefined") { %>
        <p class="register-error"><%= error %></p>
      <% } %>

      <!-- Nombre de la tienda -->
      <div class="form-group">
        <label for="nombre_tienda">Nombre de la tienda</label>
        <input 
          type="text"
          id="nombre_tienda"
          name="nombre_tienda"
          placeholder="Ej: Librería Central"
          required
        >
      </div>

      <!-- Password -->
      <div class="form-group">
        <label for="password">Contraseña</label>
        <input 
          type="password"
          id="password"
          name="password"
          placeholder="Contraseña segura"
          minlength="6"
          required
        >
      </div>

      <!-- Dirección -->
      <div class="form-group">
        <label for="direccion">Dirección</label>
        <input 
          type="text"
          id="direccion"
          name="direccion"
          placeholder="Ej: Calle Mayor 1, Madrid"
          required
        >
      </div>

      <!-- Descripción -->
      <div class="form-group">
        <label for="descripcion">Descripción de la tienda</label>
        <textarea
          id="descripcion"
          name="descripcion"
          rows="3"
          placeholder="Escribe una breve descripción…"
          required
        ></textarea>
      </div>

      <button type="submit" class="btn-submit">Crear tienda</button>

    </form>

  </main>

  <script src="js/register.js" type="module" defer></script>
</body>
</html>
