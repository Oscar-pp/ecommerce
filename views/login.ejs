<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <title>
    <%= titulo %>
  </title>
  <link rel="stylesheet" href="<%= filecss %>">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<body>

  <main class="login-container">

    <form action="/api/login" method="POST" class="login-card" autocomplete="off">

      <h2 class="login-title">Iniciar Sesión</h2>

      <!-- Control de errores -->
      <% if (typeof error !=="undefined" ) { %>
        <p class="login-error">
          <%= error %>
        </p>
        <% } %>

          <!-- Email -->
          <div class="form-group">
            <label for="nombreEmpresa">Nombre empresa</label>
            <input type="text" id="nombreEmpresa" name="nombreEmpresa" placeholder="Nombre empresa" required>
          </div>

          <!-- Password -->
          <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" placeholder="Tu contraseña" required>
          </div>

          <button type="submit" class="btn-submit">Entrar</button>

          <p class="register-text">
            ¿No tienes cuenta? <a href="/register">Regístrate</a>
          </p>

    </form>

  </main>

  <script src="/js/login.js" type="module" defer></script>
</body>


</html>